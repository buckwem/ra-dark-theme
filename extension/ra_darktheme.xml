<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_RA_DARKTHEME</name>
    <author>Mark Buckwell</author>
    <creationDate>2026-11</creationDate>
    <copyright>Copyright (C) 2026 Mark Buckwell</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>0.1.0-beta1</version>
    <description>PLG_SYSTEM_RA_DARKTHEME_XML_DESCRIPTION</description>
    <namespace path="src">RADarkTheme\Plugin\System\RaDarktheme</namespace>
    <files>
        <folder plugin="ra_darktheme">services</folder>
        <folder>src</folder>
        <filename>LICENSE.txt</filename>
        <filename>THIRD_PARTY_NOTICES.txt</filename>
    </files>
    <media destination="plg_system_ra_darktheme" folder="media">
        <folder>css</folder>
        <folder>js</folder>
    </media>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_ra_darktheme.ini</language>
        <language tag="en-GB">en-GB/plg_system_ra_darktheme.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="default_theme" type="list" default="system" filter="cmd"
                    label="PLG_SYSTEM_RA_DARKTHEME_DEFAULT_LABEL" description="PLG_SYSTEM_RA_DARKTHEME_DEFAULT_DESC">
                    <option value="system">PLG_SYSTEM_RA_DARKTHEME_SYSTEM</option>
                    <option value="light">PLG_SYSTEM_RA_DARKTHEME_LIGHT</option>
                    <option value="dark">PLG_SYSTEM_RA_DARKTHEME_DARK</option>
                </field>
                <field name="show_toggle" type="radio" layout="joomla.form.field.radio.switcher"
                    default="1" filter="integer" label="PLG_SYSTEM_RA_DARKTHEME_TOGGLE_LABEL">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="position" type="list" default="header" filter="cmd"
                    label="PLG_SYSTEM_RA_DARKTHEME_POSITION_LABEL" description="PLG_SYSTEM_RA_DARKTHEME_POSITION_DESC">
                    <option value="header">PLG_SYSTEM_RA_DARKTHEME_HEADER</option>
                    <option value="bottom-right">PLG_SYSTEM_RA_DARKTHEME_RIGHT</option>
                    <option value="bottom-left">PLG_SYSTEM_RA_DARKTHEME_LEFT</option>
                </field>
                <field name="weather" type="radio" layout="joomla.form.field.radio.switcher"
                    default="1" filter="integer" label="PLG_SYSTEM_RA_DARKTHEME_WEATHER_LABEL"
                    description="PLG_SYSTEM_RA_DARKTHEME_WEATHER_DESC">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="template" type="text" default="g5_hydrogen" filter="cmd" maxlength="80"
                    label="PLG_SYSTEM_RA_DARKTHEME_TEMPLATE_LABEL" description="PLG_SYSTEM_RA_DARKTHEME_TEMPLATE_DESC" />
            </fieldset>
        </fields>
    </config>
</extension>
